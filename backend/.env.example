# Server Configuration
NODE_ENV=
PORT=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hyperlocal_marketplace

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptography (32-byte key for AES-256-GCM encryption in hex)
ENCRYPTION_KEY=

# ============================================================
# RAZORPAY PAYMENT CONFIGURATION
# ============================================================
# Public key — safe to share with frontend (via VITE_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=

# Secret key — NEVER expose in frontend or source control
RAZORPAY_KEY_SECRET=

# Webhook secret — used only for server-side raw-body signature verification
# NEVER log, NEVER return in API responses
RAZORPAY_WEBHOOK_SECRET=

# Payment provider name (used internally — currently only razorpay supported)
PAYMENT_PROVIDER=razorpay

# Currency for all transactions (ISO 4217)
PAYMENT_CURRENCY=INR

# Minutes before a PaymentOrder (Razorpay order) expires
PAYMENT_ORDER_EXPIRY_MINUTES=15

# Base URL for payment callbacks (your backend's public URL)
# Example: https://api.yourdomain.com
PAYMENT_CALLBACK_BASE_URL=

# Maximum bytes for webhook request body (default: 102400 = 100KB)
PAYMENT_WEBHOOK_MAX_BODY_BYTES=102400

# ============================================================
# VITE FRONTEND VARIABLE (replicate in frontend/.env)
# ============================================================
# Only VITE_ prefixed vars are exposed to the browser.
# NEVER put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET here.
# VITE_API_URL=http://localhost:5001/api
# VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_PUBLIC_KEY_ID

# ============================================================
# CLOUD STORAGE
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Monitoring
SENTRY_DSN=

# ============================================================
# OAUTH CONFIGURATION
# ============================================================
# Google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/oauth/google/callback

# Apple
APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# Apple Private Key should be a single-line string with literal \n
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:5001/api/auth/oauth/apple/callback

